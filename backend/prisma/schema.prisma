  @@unique([user_id, event_id])
  @@map("dividends")
}

model Beneficiary {
  id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String                   @db.Uuid
  name         String                   @db.VarChar(255)
  nickname     String?                  @db.VarChar(100)
  phone        String?                  @db.VarChar(50)
  notes        String?
  created_at   DateTime                 @default(now()) @db.Timestamptz(6)
  user         User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  accounts     BeneficiaryAccount[]
  transactions BeneficiaryTransaction[]

  @@map("beneficiaries")
}

model BeneficiaryAccount {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  beneficiary_id String      @db.Uuid
  account_label  String?     @db.VarChar(100) // e.g., "HBL Savings", "NayaPay"
  account_no     String      @db.VarChar(100) // full or partial account/IBAN/phone
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  beneficiary    Beneficiary @relation(fields: [beneficiary_id], references: [id], onDelete: Cascade)

  @@map("beneficiary_accounts")
}

model BeneficiaryTransaction {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  beneficiary_id        String      @db.Uuid
  bank_transaction_id   String? // cuid — matches BankTransactionLog.id
  wallet_transaction_id String? // cuid — matches WalletTransactionLog.id (future)
  amount                Decimal     @db.Decimal(15, 2)
  direction             String      @db.VarChar(10) // 'credit' | 'debit'
  transaction_date      DateTime    @db.Date
  description           String?
  created_at            DateTime    @default(now()) @db.Timestamptz(6)
  beneficiary           Beneficiary @relation(fields: [beneficiary_id], references: [id], onDelete: Cascade)

  @@unique([beneficiary_id, bank_transaction_id])
  @@map("beneficiary_transactions")
}

model Feedback {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type        String   @db.VarChar(20) // 'bug' | 'feature' | 'question' | 'other'
  title       String   @db.VarChar(200)
  description String
  screenshot  String?  @db.Text
  status      String   @default("open") @db.VarChar(20) // 'open' | 'in_progress' | 'resolved'
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id])
  @@index([status])
  @@map("feedback")
}

// A file uploaded for preview, waiting to be imported. Commit only accepts a
// session that belongs to the signed-in user and the same account, has not
// expired, and has not been imported already. Expired files are cleaned up.
model UploadSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  kind         String    @db.VarChar(10) // 'bank' | 'wallet'
  account_id   String    @db.Uuid
  file_path    String
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  expires_at   DateTime  @db.Timestamptz(6)
  committed_at DateTime? @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("upload_sessions")
}

// One row per scheduled job run. The unique (job, run_key) claim means that
// with several API replicas only one runs each scheduled slot; the row also
// records how the run went.
model JobRun {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job         String    @db.VarChar(50)
  run_key     String    @db.VarChar(40) // the scheduled slot, e.g. 2026-10-27T08:00
  status      String    @default("running") @db.VarChar(16) // running | ok | failed
  started_at  DateTime  @default(now()) @db.Timestamptz(6)
  finished_at DateTime? @db.Timestamptz(6)
  error       String?

  @@unique([job, run_key])
  @@index([started_at])
  @@map("job_runs")
}
