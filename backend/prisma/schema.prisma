  security_name         String?   @db.VarChar(255)
  iban                  String?   @db.VarChar(100)
  financial_year        String?   @db.VarChar(50)
  gross_dividend_amount Decimal   @db.Decimal(15, 2)
  net_dividend_amount   Decimal   @db.Decimal(15, 2)
  status                String?   @db.VarChar(50)
  payment_date          DateTime? @db.Date
  reason                String?
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
