generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model User {
  id                         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                      String              @unique
  name                       String
  password_hash              String?
  role                       String              @default("user") @db.VarChar(50) // 'super.admin', 'admin', 'user'
  app_pin_code               String?             @db.VarChar(255)
  // sha256 of the one-time code (never the code itself)
  otp_code                   String?             @db.VarChar(64)
  otp_expires_at             DateTime?           @db.Timestamptz(6)
  // 'login' | 'reset' — a login code can't reset the password and vice versa
  otp_purpose                String?             @db.VarChar(20)
  otp_attempts               Int                 @default(0)
  failed_login_attempts      Int                 @default(0)
  locked_until               DateTime?           @db.Timestamptz(6)
  pin_failed_attempts        Int                 @default(0)
  // Bumped to sign out every session (password change, deactivation, sign out everywhere)
  token_version              Int                 @default(0)
  must_change_password       Boolean             @default(false)
  email_verified             Boolean             @default(false)
  email_verification_token   String?             @db.VarChar(128)
  email_verification_expires DateTime?           @db.Timestamptz(6)
  terms_accepted_at          DateTime?           @db.Timestamptz(6)
  privacy_accepted_at        DateTime?           @db.Timestamptz(6)
  // First-run onboarding — null = user is sent to /onboarding
  onboarded_at               DateTime?           @db.Timestamptz(6)
  // Interest keys picked during onboarding (see src/constants/interests.js);
  // null = show every menu item, [] = core pages only
  interests                  Json?
  // OAuth identity providers — null for password-only accounts
  auth_provider              String?             @db.VarChar(20) // 'google' | 'apple' | null (password)
  provider_id                String?             @db.VarChar(255) // sub/uid from provider
  avatar_url                 String?             @db.VarChar(512)
  // Soft delete — admins "request" deletion (deactivates login); super.admin reviews → restore or hard-delete
  deleted_at                 DateTime?           @db.Timestamptz(6)
  deletion_requested_by      String?             @db.Uuid
  deletion_requested_at      DateTime?           @db.Timestamptz(6)
  created_at                 DateTime            @default(now()) @db.Timestamptz(6)
  expenses                   Expense[]
  mutual_funds               MutualFund[]
  stocks                     Stock[]
  stock_transactions         StockTransaction[]
  people                     Person[]
  dues_transactions          DuesTransaction[]
  rent_entries               RentEntry[]
  portfolio_snapshots        PortfolioSnapshot[]
  psx_snapshots              PsxSnapshot[]
  bank_investments           BankInvestment[]
  wallets                    Wallet[]
  banks                      Bank[]
  institutions               Institution[]
  broker_accounts            BrokerAccount[]
  zakat                      Zakat[]
  assets                     Asset[]
  dividends                  Dividend[]
  category_patterns          CategoryPattern[]
  category_cache             CategoryCache[]
  beneficiaries              Beneficiary[]
  chat_sessions              ChatSession[]
  chat_documents             ChatDocument[]
  networth_snapshots         NetWorthSnapshot[]
  recurring_payments         RecurringPayment[]
  debts                      Debt[]
  debt_payments              DebtPayment[]
  gold_items                 GoldItem[]
  gold_pin                   GoldPin?
  feedback                   Feedback[]
  watchlist                  Watchlist[]
  upload_sessions            UploadSession[]

  @@index([deleted_at])
  @@map("users")
}

// Daily snapshot of each user's aggregated net worth. Written by the
// nightly cron job (services/cron.service.js → snapshotAllUsersNetWorth).
// Used by the /net-worth page to render history.
model NetWorthSnapshot {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String   @db.Uuid
  captured_at        DateTime @default(now()) @db.Timestamptz(6)
  bank_total         Decimal  @db.Decimal(15, 2)
  wallet_total       Decimal  @db.Decimal(15, 2)
  investment_total   Decimal  @db.Decimal(15, 2)
  asset_total        Decimal  @db.Decimal(15, 2)
  receivable_total   Decimal  @db.Decimal(15, 2)
  payable_total      Decimal  @db.Decimal(15, 2)
  rent_balance_total Decimal  @db.Decimal(15, 2)
  expense_total      Decimal  @db.Decimal(15, 2)
  net_worth          Decimal  @db.Decimal(15, 2)
  gold_total         Decimal  @default(0) @db.Decimal(15, 2)
  debt_total         Decimal  @default(0) @db.Decimal(15, 2)
  // Which net-worth definition produced net_worth (see wealth.service.js)
  definition_version String   @default("v1") @db.VarChar(10)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, captured_at])
  @@map("networth_snapshots")
}

// Recurring payments / subscriptions / bills. The cron job in
// services/cron.service.js queries rows where next_due_date - now is
// within reminder_days and sends an email reminder.
model RecurringPayment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @db.Uuid
  name             String // "Netflix", "K-Electric"
  amount           Decimal   @db.Decimal(15, 2)
  currency         String    @default("PKR") @db.VarChar(8)
  category         String?
  frequency        String    @db.VarChar(16) // "weekly" | "monthly" | "yearly"
  next_due_date    DateTime  @db.Date
  // Intended day of the month (1–31); short months fall on their last day
  due_day          Int?
  auto_debit       Boolean   @default(false)
  bank_id          String?   @db.Uuid // optional debit-from account (not FK)
  reminder_days    Int       @default(3)
  is_active        Boolean   @default(true)
  last_paid_at     DateTime? @db.Timestamptz(6)
  last_reminder_at DateTime? @db.Timestamptz(6)
  notes            String?
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, next_due_date])
  @@index([user_id, is_active])
  @@map("recurring_payments")
}

// Institutional debt (credit cards, loans, mortgages) — distinct from
// the interpersonal Dues ledger. Outstanding balance flows into the
// dashboard net-worth calculation as a liability.
model Debt {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  name            String // "HBL Credit Card", "Car Loan"
  debt_type       String    @db.VarChar(32) // credit_card | personal_loan | mortgage | car_loan | other
  principal       Decimal   @db.Decimal(15, 2)
  outstanding     Decimal   @db.Decimal(15, 2)
  interest_rate   Decimal?  @db.Decimal(5, 2) // annual %
  minimum_payment Decimal?  @db.Decimal(15, 2)
  due_day         Int? // day of month (1..28)
  start_date      DateTime? @db.Date
  target_payoff   DateTime? @db.Date
  institution_id  String?   @db.Uuid
  notes           String?
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user     User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  payments DebtPayment[]

  @@index([user_id, is_active])
  @@map("debts")
}

model DebtPayment {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  debt_id           String   @db.Uuid
  user_id           String   @db.Uuid
  amount            Decimal  @db.Decimal(15, 2)
  paid_at           DateTime @default(now()) @db.Timestamptz(6)
  principal_portion Decimal? @db.Decimal(15, 2)
  interest_portion  Decimal? @db.Decimal(15, 2)
  notes             String?
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  debt Debt @relation(fields: [debt_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([debt_id, paid_at])
  @@index([user_id, paid_at])
  @@map("debt_payments")
}

// Gold Vault — physical gold tracked by weight + carat. Per-item value is
// computed live from the latest GoldPriceHistory row at request time.
// Gated by a separate GoldPin (not the app-wide app_pin_code).
model GoldItem {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 String    @db.Uuid
  name                    String    @db.VarChar(255) // "Bridal set", "Engagement ring"
  type                    String    @db.VarChar(20) // ring | set | chain | bangle | earring | other
  weight_grams            Decimal   @db.Decimal(10, 3) // physical weight in grams
  carats                  Int       @default(20) // 24 | 22 | 21 | 20 | 18
  purchase_date           DateTime? @db.Date
  purchase_price_per_gram Decimal?  @db.Decimal(12, 2)
  image_url               String?   @db.Text
  notes                   String?
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("gold_items")
}

// Daily snapshots of the gold price scraped from a public source.
// 1 tola = 11.664 grams (Pakistani standard).
model GoldPriceHistory {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date               DateTime @db.Date
  price_24k_per_tola Decimal  @db.Decimal(12, 2)
  price_24k_per_gram Decimal  @db.Decimal(12, 2)
  source             String   @default("hamariweb") @db.VarChar(32)
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  @@unique([date])
  @@index([date])
  @@map("gold_price_history")
}

// SEPARATE PIN for the Gold Vault. Intentionally not reusing
// users.app_pin_code — the second lock is a feature, not a bug.
model GoldPin {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @unique @db.Uuid
  pin_hash        String    @db.VarChar(255)
  failed_attempts Int       @default(0)
  locked_until    DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("gold_pins")
}

// FX rates fetched daily by services/fxRate.service.js. Multiple rows
// per pair build up history. The latest row per (base, quote) is what
// most consumers use; the time series is there for charts and audit.
model FxRate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  base       String   @db.VarChar(8)
  quote      String   @db.VarChar(8)
  rate       Decimal  @db.Decimal(15, 6)
  fetched_at DateTime @default(now()) @db.Timestamptz(6)
  source     String   @db.VarChar(32) // "open.er-api" | "manual"

  @@index([base, quote, fetched_at])
  @@map("fx_rates")
}

// Controls which sidebar menu items are visible to each role.
// Each row lists the role names allowed to see that menu item.
// Admins/super.admins must still be in this list to see admin-only items.
model MenuVisibility {
  path             String   @id @db.VarChar(100)
  name             String   @db.VarChar(80)
  icon             String   @db.VarChar(40)
  visible_to_roles String[] @default(["user", "admin", "super.admin"])
  sort_order       Int      @default(0)
  // Non-null for sub-sections (e.g. "/personal#gold" → parent "/personal").
  // Sub-rows are excluded from the sidebar and gate page tabs instead.
  parent_path      String?  @db.VarChar(100)
  updated_at       DateTime @updatedAt

  @@index([parent_path])
  @@map("menu_visibility")
}

model ChatSession {
  id         String        @id @default(cuid())
  user_id    String        @db.Uuid
  title      String?       @db.VarChar(200)
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt
  user       User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages   ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id         String      @id @default(cuid())
  session_id String
  role       String      @db.VarChar(20)
  content    String      @db.Text
  tool_name  String?     @db.VarChar(100)
  tool_data  Json?
  // Document excerpts the answer drew on: [{ ref, filename, similarity, excerpt }]
  citations  Json?
  // Tools the answer used and when their data was read: [{ name, at }]
  tools_used Json?
  created_at DateTime    @default(now())
  session    ChatSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id, created_at])
  @@map("chat_messages")
}

model ChatDocument {
  id         String          @id @default(cuid())
  user_id    String          @db.Uuid
  filename   String          @db.VarChar(255)
  mime_type  String          @db.VarChar(100)
  char_count Int             @default(0)
  // embedding → ready | failed. Only ready documents are searched.
  status     String          @default("ready") @db.VarChar(20)
  error      String?
  // true when the document was longer than the indexing limit
  truncated  Boolean         @default(false)
  created_at DateTime        @default(now())
  user       User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chunks     DocumentChunk[]

  @@map("chat_documents")
}

model DocumentChunk {
  id          String                       @id @default(cuid())
  document_id String
  chunk_index Int
  content     String                       @db.Text
  embedding   Unsupported("vector(3072)")?
  document    ChatDocument                 @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([document_id])
  @@map("document_chunks")
}

model Expense {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String   @db.Uuid
  amount              Decimal  @db.Decimal(15, 2)
  category            String   @db.VarChar(100)
  expense_date        DateTime @db.Date
  payment_method      String?  @db.VarChar(50)
  notes               String?
  // Set when the expense was created by approving an imported transaction.
  // Unique: one transaction can only ever produce one expense. Reports count
  // the transaction itself, so linked expenses are never added on top of it.
  source_bank_tx_id   String?  @unique
  source_wallet_tx_id String?  @unique
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, expense_date])
  @@map("expenses")
}

model MutualFund {
  id                        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                   String              @db.Uuid
  fund_name                 String              @db.VarChar(255)
  fund_symbol               String              @db.VarChar(50)
  units                     Decimal             @db.Decimal(15, 4)
  current_nav               Decimal             @db.Decimal(10, 4)
  current_value             Decimal             @db.Decimal(15, 2)
  invested_amount           Decimal             @db.Decimal(15, 2)
  gain_loss_fytd            Decimal?            @db.Decimal(15, 2)
  gain_loss_since_inception Decimal?            @db.Decimal(15, 2)
  status                    String              @default("active") @db.VarChar(20)
  created_at                DateTime            @default(now()) @db.Timestamptz(6)
  user                      User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  history                   MutualFundHistory[]

  @@map("mutual_funds")
}

model MutualFundHistory {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mutual_fund_id String     @db.Uuid
  nav            Decimal    @db.Decimal(10, 4)
  value          Decimal    @db.Decimal(15, 2)
  record_date    DateTime   @default(now()) @db.Timestamptz(6)
  mutual_fund    MutualFund @relation(fields: [mutual_fund_id], references: [id], onDelete: Cascade)

  @@map("mutual_fund_history")
}

model Stock {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String             @db.Uuid
  stock_symbol         String             @db.VarChar(20)
  company_name         String?            @db.VarChar(255)
  current_market_price Decimal?           @default(0.00) @db.Decimal(15, 2)
  created_at           DateTime           @default(now()) @db.Timestamptz(6)
  user                 User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions         StockTransaction[]

  @@map("stocks")
}

model StockTransaction {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  stock_id      String   @db.Uuid
  buy_date      DateTime @db.Date
  buy_price     Decimal  @db.Decimal(10, 2)
  quantity      Int
  brokerage_fee Decimal? @default(0.00) @db.Decimal(10, 2)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  stock         Stock    @relation(fields: [stock_id], references: [id], onDelete: Cascade)

  @@map("stock_transactions")
}

model Person {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String            @db.Uuid
  name         String            @db.VarChar(255)
  email        String?           @db.VarChar(255)
  created_at   DateTime          @default(now()) @db.Timestamptz(6)
  user         User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions DuesTransaction[]

  @@map("people")
}

model DuesTransaction {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String   @db.Uuid
  person_id        String   @db.Uuid
  transaction_type String   @db.VarChar(20) // 'receivable' or 'payable'
  amount           Decimal  @db.Decimal(15, 2)
  transaction_date DateTime @db.Date
  description      String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  person           Person   @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("dues_transactions")
}

model RentEntry {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @db.Uuid
  month          String   @db.VarChar(20)
  year           Int
  payer_name     String   @db.VarChar(255)
  amount         Decimal  @db.Decimal(15, 2)
  payment_date   DateTime @db.Date
  account_source String   @db.VarChar(255)
  notes          String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("rent_entries")
}

model PortfolioSnapshot {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @db.Uuid
  upload_date    DateTime @default(now()) @db.Timestamptz(6)
  total_value    Decimal  @db.Decimal(15, 2)
  total_gain     Decimal  @db.Decimal(15, 2)
  total_invested Decimal  @db.Decimal(15, 2)
  funds_data     Json
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("portfolio_snapshots")
}

model PsxSnapshot {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @db.Uuid
  snapshot_date  DateTime @db.Date // One snapshot per day
  total_custody  Decimal  @db.Decimal(15, 2)
  total_invested Decimal  @db.Decimal(15, 2)
  holdings_data  Json // Array of { symbol, holding, market_rate, custody_val }
  summary_data   Json? // Optional: { trading_cash, working_capital, total_worth, margin_pct, etc. }
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, snapshot_date])
  @@map("psx_snapshots")
}

model BankInvestment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String   @db.Uuid
  transaction_date DateTime @db.Date
  amount           Decimal  @db.Decimal(15, 2) // Positive for deposit, negative for withdrawal
  description      String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("bank_investments")
}

model Wallet {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String            @db.Uuid
  name                 String            @db.VarChar(100)
  institution          String            @db.VarChar(100)
  balance              Decimal           @default(0.00) @db.Decimal(15, 2)
  currency             String            @default("PKR") @db.VarChar(10)
  exchange_rate        Decimal           @default(1.00) @db.Decimal(15, 4)
  color_theme          String            @default("blue") @db.VarChar(50)
  account_num          String?           @db.VarChar(50)
  // Where the balance came from and the date it is true for, so an older
  // statement can never overwrite a newer balance.
  balance_as_of        DateTime?         @db.Date
  balance_source       String?           @db.VarChar(20) // 'statement' | 'manual' | 'opening'
  balance_statement_id String?           @db.Uuid
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  user                 User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  statements           WalletStatement[]

  @@index([user_id])
  @@map("wallets")
}

model WalletStatement {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wallet_id          String   @db.Uuid
  month              String   @db.VarChar(20)
  year               Int
  file_path          String?
  file_hash          String?  @db.VarChar(64)
  password_encrypted String?  @db.Text
  upload_date        DateTime @default(now()) @db.Timestamptz(6)
  transactions       Json?
  opening_balance    Decimal? @db.Decimal(15, 2)
  closing_balance    Decimal? @db.Decimal(15, 2)
  total_credits      Decimal  @default(0) @db.Decimal(15, 2)
  total_debits       Decimal  @default(0) @db.Decimal(15, 2)
  transaction_count  Int      @default(0)
  processing_status  String   @default("pending") @db.VarChar(50)

  wallet              Wallet                 @relation(fields: [wallet_id], references: [id], onDelete: Cascade)
  parsed_transactions WalletTransactionLog[]

  @@index([wallet_id])
  @@map("wallet_statements")
}

model WalletTransactionLog {
  id                  String          @id @default(cuid())
  wallet_statement_id String          @db.Uuid
  wallet_statement    WalletStatement @relation(fields: [wallet_statement_id], references: [id], onDelete: Cascade)

  transaction_date DateTime @db.Date
  description      String   @db.Text
  debit_amount     Decimal? @db.Decimal(15, 2)
  credit_amount    Decimal? @db.Decimal(15, 2)
  net_amount       Decimal  @db.Decimal(15, 2)

  suggested_category  String?  @db.VarChar(100)
  category_confidence Decimal? @db.Decimal(3, 2)

  is_duplicate    Boolean @default(false)
  // Id of the earlier log this one repeats (a cuid, like every log id).
  duplicate_of_id String?
  // 'certain' = auto-rejected repeat; 'possible' = flagged for the user to decide
  duplicate_match String? @db.VarChar(20)

  user_approved     Boolean @default(false)
  approved_category String? @db.VarChar(100)

  created_expense_id String? @db.Uuid

  notes             String?  @db.Text
  processing_status String   @default("pending") @db.VarChar(50)
  created_at        DateTime @default(now())

  @@index([wallet_statement_id])
  @@index([user_approved])
  @@index([processing_status])
  @@index([transaction_date])
  @@map("wallet_transaction_logs")
}

model Bank {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String          @db.Uuid
  name                 String          @db.VarChar(255)
  account_no           String          @db.VarChar(100)
  iban_no              String          @db.VarChar(100)
  currency             String          @default("PKR") @db.VarChar(10)
  exchange_rate        Decimal         @default(1.00) @db.Decimal(15, 4)
  starting_balance     Decimal         @db.Decimal(15, 2)
  current_balance      Decimal         @default(0.00) @db.Decimal(15, 2)
  // Where the balance came from and the date it is true for, so an older
  // statement can never overwrite a newer balance.
  balance_as_of        DateTime?       @db.Date
  balance_source       String?         @db.VarChar(20) // 'statement' | 'manual' | 'opening'
  balance_statement_id String?         @db.Uuid
  created_at           DateTime        @default(now()) @db.Timestamptz(6)
  user                 User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  statements           BankStatement[]

  @@index([user_id])
  @@map("banks")
}

model BankStatement {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bank_id            String   @db.Uuid
  month              String   @db.VarChar(20)
  year               Int
  file_path          String? // Location of uploaded file
  file_hash          String?  @db.VarChar(64) // SHA256 for dedup
  password_encrypted String?  @db.Text // Encrypted password if PDF is protected
  upload_date        DateTime @default(now()) @db.Timestamptz(6)
  transactions       Json? // Parsed transaction data
  opening_balance    Decimal? @db.Decimal(15, 2)
  closing_balance    Decimal? @db.Decimal(15, 2)
  total_credits      Decimal  @default(0) @db.Decimal(15, 2)
  total_debits       Decimal  @default(0) @db.Decimal(15, 2)
  transaction_count  Int      @default(0)
  processing_status  String   @default("pending") @db.VarChar(50) // pending, reviewed, approved, reconciled

  bank                Bank                 @relation(fields: [bank_id], references: [id], onDelete: Cascade)
  parsed_transactions BankTransactionLog[]

  @@index([bank_id])
  @@map("bank_statements")
}

model BankTransactionLog {
  id                String        @id @default(cuid())
  bank_statement_id String        @db.Uuid
  bank_statement    BankStatement @relation(fields: [bank_statement_id], references: [id], onDelete: Cascade)

  transaction_date DateTime @db.Date
  description      String   @db.Text
  debit_amount     Decimal? @db.Decimal(15, 2)
  credit_amount    Decimal? @db.Decimal(15, 2)
  net_amount       Decimal  @db.Decimal(15, 2)

  suggested_category  String?  @db.VarChar(100)
  category_confidence Decimal? @db.Decimal(3, 2)

  is_duplicate    Boolean @default(false)
  // Id of the earlier log this one repeats (a cuid, like every log id).
  duplicate_of_id String?
  // 'certain' = auto-rejected repeat; 'possible' = flagged for the user to decide
  duplicate_match String? @db.VarChar(20)

  user_approved     Boolean @default(false)
  approved_category String? @db.VarChar(100)

  created_expense_id String? @db.Uuid

  notes             String?  @db.Text
  processing_status String   @default("pending") @db.VarChar(50) // pending, approved, rejected, disputed
  created_at        DateTime @default(now())

  @@index([bank_statement_id])
  @@index([user_approved])
  @@index([processing_status])
  @@index([transaction_date])
  @@map("bank_transaction_logs")
}

model CategoryPattern {
  id      String @id @default(cuid())
  user_id String @db.Uuid
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  keyword           String  @db.VarChar(100)
  assigned_category String  @db.VarChar(100)
  confidence        Decimal @db.Decimal(3, 2)

  occurrences Int      @default(1)
  last_used   DateTime @default(now())

  @@unique([user_id, keyword, assigned_category])
  @@map("category_patterns")
}

model CategoryCache {
  id          String   @id @default(cuid())
  user_id     String   @db.Uuid
  description String   @db.Text
  category    String   @db.VarChar(100)
  source      String   @default("ai") @db.VarChar(20)
  confidence  Decimal  @db.Decimal(3, 2)
  hit_count   Int      @default(1)
  last_used   DateTime @default(now())
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, description])
  @@map("category_cache")
}

model Institution {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  name       String   @db.VarChar(100)
  type       String   @default("bank") @db.VarChar(50) // e.g. bank, wallet, cash
  color      String   @default("blue") @db.VarChar(20) // For UI thematic matching
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, name])
  @@map("institutions")
}

model BrokerAccount {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String   @db.Uuid
  account_title      String   @db.VarChar(255)
  client_code        String   @db.VarChar(100)
  participant_acc_no String?  @db.VarChar(100)
  cdc_sub_acc_no     String?  @db.VarChar(100)
  stock_pin_code     String?  @db.VarChar(255)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("broker_accounts")
}

model Zakat {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  amount      Decimal  @db.Decimal(15, 2)
  description String?
  date        DateTime @default(now()) @db.Date // When it was paid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("zakat")
}

model Asset {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  name          String    @db.VarChar(255)
  type          String    @db.VarChar(100)
  value         Decimal   @default(0.00) @db.Decimal(15, 2)
  purchase_date DateTime? @db.Date
  description   String?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("assets")
}

model PsxStock {
  id          String   @id @default(cuid())
  ticker      String   @unique // "FFL", "ENGRO"
  companyName String
  price       Decimal  @db.Decimal(15, 4)
  change      Decimal  @db.Decimal(15, 4)
  changePct   Decimal  @db.Decimal(15, 4)
  volume      BigInt
  high        Decimal  @db.Decimal(15, 4)
  low         Decimal  @db.Decimal(15, 4)
  marketCap   Decimal? @db.Decimal(18, 4)
  lastUpdated DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("psx_stocks")
}

// Daily end-of-day price per ticker. PsxStock holds only the *current*
// price and is overwritten on every sync, so without this table there is
// no price history at all — no sparklines, no per-ticker charts, no way
// to compute a 30-day move from anything other than the user's own
// snapshot uploads. Populated by the weekday price-sync cron.
//
// Date is keyed to the Asia/Karachi trading day (see utils/dates.js),
// following the same convention as GoldPriceHistory.
model PsxPriceHistory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticker     String   @db.VarChar(20)
  date       DateTime @db.Date
  // The PSX company page does not reliably expose an opening price, so
  // `open` stays null rather than being back-filled with a guess.
  open       Decimal? @db.Decimal(15, 4)
  high       Decimal? @db.Decimal(15, 4)
  low        Decimal? @db.Decimal(15, 4)
  close      Decimal  @db.Decimal(15, 4)
  volume     BigInt?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([ticker, date])
  @@index([ticker, date])
  @@map("psx_price_history")
}

// Outcome of one scrape run. PsxStock.lastUpdated is @updatedAt, so it
// bumps on every write including a degraded one — it cannot tell a good
// sync from a bad one. This can, which is what the staleness badge on
// the Stocks page reads.
model ScrapeRun {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source         String    @db.VarChar(32) // 'psx_prices' | 'psx_news'
  status         String    @db.VarChar(16) // 'success' | 'partial' | 'failed'
  started_at     DateTime  @default(now()) @db.Timestamptz(6)
  finished_at    DateTime? @db.Timestamptz(6)
  tickers_ok     Int       @default(0)
  tickers_failed Int       @default(0)
  error          String?

  @@index([source, started_at])
  @@map("scrape_runs")
}

// Tickers a user tracks but may not hold. Replaces a 14-symbol array that
// was hardcoded twice in Stocks.jsx and injected into the allocation donut
// as zero-value slices.
model Watchlist {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id  String   @db.Uuid
  ticker   String   @db.VarChar(20)
  notes    String?
  added_at DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, ticker])
  @@index([user_id])
  @@map("watchlist")
}

model StockNews {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticker      String   @db.VarChar(20)
  title       String
  link        String   @unique
  source      String?
  publishedAt DateTime
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([ticker])
  @@map("stock_news")
}

model Dividend {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
