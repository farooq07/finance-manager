# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# Server
PORT=5000

# JWT Authentication
JWT_SECRET=your_jwt_secret_here

# Email (Gmail SMTP)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Onboarding — set to 'false' to disable public self-registration
# When disabled, only super.admin can create accounts via the Users panel
ALLOW_REGISTRATION=true

# Frontend URL (for CORS)
FRONTEND_URL=https://your-vercel-app.vercel.app

# ── AI Providers ─────────────────────────────────────────────────────────────
#
# AI_CHAT_PROVIDER controls which provider the AI Assistant chat uses.
# AI_PROVIDER controls the transaction auto-categoriser (separate setting).
#
# Options:
#   groq    → Groq (FREE, fast, generous limits)
#             Get key: https://console.groq.com  → API Keys
#   gemini  → Google Gemini (free tier has daily limits)
#             Get key: https://aistudio.google.com  → Get API Key
#   openai  → OpenAI (paid, requires billing)
#             Get key: https://platform.openai.com  → API Keys
#
# If not set, auto-detects: Groq first, then Gemini.
# ─────────────────────────────────────────────────────────────────────────────

# Groq — free tier, ~6,000 requests/day, 500k tokens/day on llama models
GROQ_API_KEY=your_groq_api_key_here
# Model options (free): llama-3.3-70b-versatile (best), llama-3.1-8b-instant (fastest)
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Gemini — free tier has daily quota limits
GEMINI_API_KEY=your_gemini_api_key_here
# Model options:
#   Free:  gemini-2.0-flash, gemini-1.5-flash-8b (higher quota, smaller model)
#   Paid:  gemini-2.5-pro, gemini-2.5-flash
# GEMINI_CHAT_MODEL=gemini-2.0-flash

# OpenAI — paid only
# OPENAI_API_KEY=your_openai_api_key_here
# Model options: gpt-4o-mini (cheap + good), gpt-4o (best quality)
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Which provider to use for the AI Assistant chat page
# AI_CHAT_PROVIDER=groq

# Which provider to use for transaction auto-categorisation
# AI_PROVIDER=groq
