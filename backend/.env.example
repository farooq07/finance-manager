# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# Server
PORT=5000

# JWT Authentication
JWT_SECRET=your_jwt_secret_here

# Email (Gmail SMTP)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Onboarding — set to 'false' to disable public self-registration
# When disabled, only super.admin can create accounts via the Users panel
ALLOW_REGISTRATION=true

# Frontend URL (for CORS)
FRONTEND_URL=https://your-vercel-app.vercel.app
